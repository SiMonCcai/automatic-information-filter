# RSS Pipeline Configuration

# Database
PIPELINE_DB_PATH=pipeline.db

# Notion Integration
NOTION_API_KEY=your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_database_id_here
NOTION_PAGE_SIZE=100

# Fetching
FETCH_TIMEOUT=30
FETCH_USER_AGENT=RSS-Pipeline/0.1.0
REQUEST_DELAY=1.0

# Deduplication
ENABLE_CONTENT_FINGERPRINT=true

# Optional title-semantic event deduplication (fail-open)
EVENT_DEDUP_ENABLED=false
EVENT_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EVENT_DEDUP_THRESHOLD=0.96
EVENT_DEDUP_WINDOW_DAYS=7
EVENT_EMBEDDING_BATCH_SIZE=8
EVENT_EMBEDDING_THREADS=1
EVENT_WINNER_MARGIN_TOTAL=2
EVENT_EMBEDDING_PYTHON=.venv-embedding/bin/python
EVENT_EMBEDDING_CACHE=.embedding-cache

# Logging
LOG_LEVEL=INFO

# AI Enrichment
AI_PROVIDER=deepseek
AI_ENRICHMENT_BATCH_SIZE=4
AI_WORKER_BATCH_SIZE=20

# DeepSeek settings
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT=90
DEEPSEEK_MAX_RETRIES=3
DEEPSEEK_MAX_CONCURRENCY=7

# GLM settings
GLM_API_KEY=your_glm_api_key_here
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
GLM_MODEL=glm-4.5-air
GLM_TIMEOUT=60
GLM_MAX_RETRIES=2
GLM_MAX_CONCURRENCY=1
GLM_MIN_REQUEST_INTERVAL=2.0
GLM_RATE_LIMIT_COOLDOWN=8.0

# Optional sync filter
SYNC_PUBLISHED_AFTER=
SYNC_SCAN_LIMIT=100
